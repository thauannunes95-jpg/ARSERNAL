-- // UTILITÁRIOS DE SISTEMA
local function SafeParent(gui)
    local success = pcall(function() gui.Parent = game:GetService("CoreGui") end)
    if not success then gui.Parent = LocalPlayer:WaitForChild("PlayerGui") end
end

local function Tween(obj, prop, value, time)
    TweenService:Create(obj, TweenInfo.new(time or 0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {[prop] = value}):Play()
end

local function MakeDraggable(gui)
    local dragging, dragInput, dragStart, startPos
    gui.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            startPos = gui.Position
        end
    end)
    gui.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
            dragInput = input
        end
    end)
    UIS.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)
    RunService.RenderStepped:Connect(function()
        if dragging and dragInput then
            local delta = dragInput.Position - dragStart
            gui.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
        end
    end)
end

-- // LÓGICA DE COMBATE (Aimbot & FOV)
local function GetClosestPlayer()
    local closest = nil
    local shortestDistance = getgenv().DZ_FOV
    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character and player.Character:FindFirstChild("Head") then
            local pos, onScreen = Camera:WorldToViewportPoint(player.Character.Head.Position)
            if onScreen then
                local dist = (Vector2.new(pos.X, pos.Y) - Vector2.new(Camera.ViewportSize.X/2, Camera.ViewportSize.Y/2)).Magnitude
                if dist < shortestDistance then
                    closest = player
                    shortestDistance = dist
                end
            end
        end
    end
    return closest
end

local function IsVisible(targetPart)
    local origin = Camera.CFrame.Position
    local direction = (targetPart.Position - origin)
    local rayParams = RaycastParams.new()
    rayParams.FilterDescendantsInstances = {LocalPlayer.Character, targetPart.Parent}
    rayParams.FilterType = Enum.RaycastFilterType.Blacklist
    local result = workspace:Raycast(origin, direction, rayParams)
    return result == nil
end

-- // ESP SYSTEM (High-Performance)
local function ApplyESP(player)
    local function Setup(char)
        local highlight = Instance.new("Highlight")
        highlight.Name = "DZ_ESP_V3"
        highlight.FillColor = Theme.ESP_Color
        highlight.OutlineColor = Color3.new(1,1,1)
        highlight.FillTransparency = 0.5
        highlight.OutlineTransparency = 0
        highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
        highlight.Parent = char
        
        RunService.Heartbeat:Connect(function()
            if not char or not char.Parent then return end
            highlight.Enabled = getgenv().DZ_ESP
        end)
    end
    player.CharacterAdded:Connect(Setup)
    if player.Character then Setup(player.Character) end
end

